{
  "uid": "netdevops-health-overview",
  "title": "NetDevOps Health Monitor",
  "tags": ["netdevops", "prometheus", "tls"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Target Probe Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-netdevops" },
      "targets": [
        {
          "expr": "netdevops_probe_up",
          "legendFormat": "{{target}} ({{check_type}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "TLS Certificate Days Until Expiry",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-netdevops" },
      "targets": [
        {
          "expr": "sort(netdevops_tls_cert_expiry_days)",
          "legendFormat": "{{target}} ({{issuer}})",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 14 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "P95 Probe Latency",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-netdevops" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(netdevops_probe_duration_seconds_bucket[5m])) by (le, target, check_type))",
          "legendFormat": "{{target}} - {{check_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Probe Errors by Failure Reason",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-netdevops" },
      "targets": [
        {
          "expr": "sum(rate(netdevops_probe_errors_total[5m])) by (target, check_type, reason)",
          "legendFormat": "{{target}} [{{check_type}}: {{reason}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ]
}